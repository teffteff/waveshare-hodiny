# /opt/remote-config/remote-config.env, root:root 600. Hodnoty vyrobi serve.py na Macu:
#   python3 infra/remote-config/serve.py hash-password
#   python3 infra/remote-config/serve.py new-totp      (otpauth:// adresu do aplikace)
REMOTE_CONFIG_PASSWORD_HASH=scrypt$32768$8$1$...$...
REMOTE_CONFIG_TOTP_SECRET=BASE32...
