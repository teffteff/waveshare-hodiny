[Unit]
Description=Nastaveni vsech hodin pres server (predavani webu hodin)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Vlastni uzivatel, ne opc (sudo bez hesla, SSH klic). Kod patri rootovi,
# sluzba zapisuje jen do state/: registrovane hodiny a posledni kod TOTP.
User=remote-config
Group=remote-config
Environment=REMOTE_CONFIG_PORT=8099
# Jen pro Caddy na stejnem stroji: sluzba veri X-Forwarded-For (brzda
# prihlaseni podle IP) a /remote-config-status nema heslo.
Environment=REMOTE_CONFIG_BIND=127.0.0.1
Environment=REMOTE_CONFIG_STATE=/opt/remote-config/state
# Vlastni jmeno (Caddy {{PORTAL_DOMAIN}}), adresy bez /remote-config.
Environment=REMOTE_CONFIG_PREFIX=
# REMOTE_CONFIG_PASSWORD_HASH a REMOTE_CONFIG_TOTP_SECRET (vzor remote-config.env.example). Bez nich
# sluzba bezi, ale nikoho neprihlasi.
EnvironmentFile=/opt/remote-config/remote-config.env
# Zadny venv, jen standardni knihovna. Interpret vyslovne 3.11, protoze
# /usr/bin/python3 je na Oracle Linuxu 8 porad 3.6 (viz rain-web.service).
ExecStart=/usr/bin/python3.11 /opt/remote-config/serve.py
UMask=0077
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/remote-config/state
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictRealtime=true

[Install]
WantedBy=multi-user.target
