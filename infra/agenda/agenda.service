[Unit]
Description=Slozi agendu z Google Kalendare pro hodiny
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Vlastni uzivatel, ne opc. Precte key.json (jeho, 400) a zapisuje do www/.
User=agenda
Group=agenda
EnvironmentFile=/opt/agenda/agenda.env
ExecStart=/opt/agenda/.venv/bin/python /opt/agenda/generate.py
Nice=10
# Type=oneshot ma TimeoutStartSec ve vychozim stavu vypnuty. Zaseknuty beh by
# jinak drzel jednotku napored a timer by dalsi spousteni preskakoval.
TimeoutStartSec=120
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
