[Unit]
Description=Staticky server s agendou pro hodiny
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Vlastni uzivatel, ne opc (sudo bez hesla, SSH klic). Kod a .venv patri
# rootovi, sluzba cte jen www/.
User=agenda
Group=agenda
Environment=AGENDA_WWW=/opt/agenda/www
Environment=AGENDA_PORT=8089
# Jen pro Caddy na stejnem stroji. Kdyby server visel na verejne IP, dal by
# se basic_auth z Caddyfile obejit primym dotazem na port 8089.
Environment=AGENDA_BIND=127.0.0.1
# Kvuli AGENDA_PRIVATE_HASH, otisku hesla k soukromym kalendarum. Stejny soubor
# jako u generatoru, aby heslo i seznam soukromych kalendaru lezely spolu.
# Soubor patri rootovi (600), systemd ho nacte pred prepnutim na uzivatele.
EnvironmentFile=/opt/agenda/agenda.env
ExecStart=/opt/agenda/.venv/bin/python /opt/agenda/serve.py
Restart=on-failure
RestartSec=5
# Sluzba je sice jen na loopbacku, ale mantinely dostane stejne jako Caddy.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
