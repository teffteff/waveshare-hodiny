# Zkopiruj do /opt/agenda/agenda.env, dopln kalendare, prava 600, vlastnik toho
# uctu, pod kterym bezi agenda.service.
#
# Cteni jde pres servisni ucet Google Cloudu, ne pres uzivatelsky OAuth: klic
# nevyprsi a neni potreba souhlasna obrazovka. Kalendar musi byt s adresou
# uctu nasdileny ve webovem rozhrani Kalendare, opravneni "Zobrazit vsechny
# podrobnosti udalosti".
#
# Poradi je vyznamne: index kalendare v tomhle seznamu si hodiny berou jako
# barvu, kterou udalost odlisi.
AGENDA_CALENDARS=prvni@group.calendar.google.com,druhy@group.calendar.google.com

# Volitelne:
# AGENDA_KEY=/opt/agenda/key.json
# AGENDA_OUTPUT=/opt/agenda/www/agenda.json
# AGENDA_TZ=Europe/Prague
# AGENDA_DAYS=3
# AGENDA_MAX_ITEMS=12
# AGENDA_MAX_TITLE=48
# AGENDA_GRACE_MINUTES=60
