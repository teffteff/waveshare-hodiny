# /opt/alerts/alerts.env, prava 600, vlastnik alerts.
#
# Push jde na ntfy stejne jako u hlidani obchodu (/opt/watch/watch.env).
# NAZEV TEMATU JE HESLO: na verejnem ntfy.sh ho muze cist i do nej psat
# kdokoli, kdo ho uhodne. Vlastni tema, ne to od hlidani obchodu, aby se
# letadla dala v aplikaci ztlumit zvlast:
#
#   python3 -c "import secrets; print('hodiny-' + secrets.token_hex(16))"
#
# V aplikaci ntfy pak Subscribe to topic a overit:
#   sudo -u alerts env $(cat /opt/alerts/alerts.env) python3.11 /opt/alerts/serve.py --test-push
NTFY_URL=https://ntfy.sh
NTFY_TOPIC=
# Jen kdyz je tema chranene pristupovym tokenem (vlastni server nebo ntfy Pro).
NTFY_TOKEN=
