# /opt/llm/llm.env, root:root 600; systemd ho nacte pred prepnutim na uzivatele llm.
#
# Klice Gemini po projektech Google Cloudu (kvota plati na projekt, ne na klic).
# Ktera sluzba patri do ktereho projektu, rika config.json.
GEMINI_KEY_HODINY=AQ....
GEMINI_KEY_RADAR=AQ....
GEMINI_KEY_WATCH=AQ....
# Zaloha mimo Google. Na klici je v OpenRouteru mesicni limit 2 USD, brana
# navic nepusti vic nez openrouter_usd_per_day z config.json.
OPENROUTER_API_KEY=sk-or-v1-...
# Tokeny sluzeb: sluzba:token, oddelene carkou. Sluzba dostane svuj token
# v promenne LLM_TOKEN (news.env, radar.env, stats.env, watch.env).
# Novy token: python3 -c "import secrets; print(secrets.token_urlsafe(24))"
LLM_TOKENS=news:...,watch:...,radar:...,stats:...
