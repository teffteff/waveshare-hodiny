# Zkopiruj do /opt/school/school.env, prava 600, vlastnik root. Cte ho jen
# systemd pro school-web.service.
#
# Prihlaseni do Skoly OnLine - to same, kterym se prihlasuje webova aplikace
# nebo mobilni aplikace. Rodicovsky ucet je lepsi nez zakovsky: dite si heslo
# muze zmenit a rozvrh by zhasl. Heslo se neposila nikam jinam nez na
# aplikace.skolaonline.cz.
SCHOOL_USERNAME=rodic.novak
SCHOOL_PASSWORD=heslo

# Ucet s vic detmi: ID nebo cast jmena. Prazdne = prvni dite. Seznam deti
# vypise --probe, viz infra/README.md, oddil Rozvrh a ukoly ze Skoly OnLine.
# SCHOOL_STUDENT=Adam

# Nastenka materske skoly z nasems.cz pod znamkami na druhe strance.
# Prazdne = nestahuje se. Heslo jde jen na nasems.cz.
# NASEMS_LOGIN=rodic@example.cz
# NASEMS_PASSWORD=heslo

# Obedy pod rozvrhem, dnes a zitra. Skolni jidelna na iCanteenu ukazuje
# jidelnicek i bez prihlaseni, staci adresa; prazdne = nestahuje se.
# Jidelnicek skolky jde pres stejne prihlaseni jako nastenka (NASEMS_LOGIN);
# NASEMS_MENU=0 ho vypne. Popisky stoji na displeji pred jidlem.
# SCHOOL_CANTEEN_URL=https://jidelna.zsondrejov.cz/
# SCHOOL_CANTEEN_MEAL=Oběd1
# SCHOOL_CANTEEN_LABEL=ZŠ
# NASEMS_MENU=1
# NASEMS_MENU_LABEL=MŠ
# SCHOOL_MEALS_POLL_MINUTES=360

# Domaci ukoly. 0 = do Skoly OnLine se na ne vubec nepta a hodiny je
# nedostanou (ucitele je zatim nezadavaji); kod zustava pro pozdejsi zapnuti.
# SCHOOL_HOMEWORK=1

# Volitelne:
# SCHOOL_API=https://aplikace.skolaonline.cz/solapi/api
# SCHOOL_TZ=Europe/Prague
# Kazdy zdroj nejvys jednou za tri hodiny; odstupy jsou zvlast, aby sla
# frekvence menit jednotlive.
# SCHOOL_DAY_POLL_MINUTES=180
# SCHOOL_NIGHT_POLL_MINUTES=180
# SCHOOL_IDLE_POLL_MINUTES=180
# SCHOOL_HOLIDAY_POLL_MINUTES=360
# SCHOOL_AUTH_BACKOFF_HOURS=6
# Nahodna odchylka kazdeho odstupu v procentech (0 = presne).
# SCHOOL_POLL_JITTER_PERCENT=10
# SCHOOL_MAX_AGE_HOURS=14
# Noc bez dotazu do Skoly OnLine, od-do v hodinach; prazdne = bez ticha.
# SCHOOL_QUIET_HOURS=22-5
# Druha stranka obrazovky: neprectene zpravy a znamky. 0 = nestahovat.
# SCHOOL_MESSAGES=1
# SCHOOL_MARKS=1
# SCHOOL_MESSAGES_POLL_MINUTES=180
# SCHOOL_MARKS_POLL_MINUTES=180
# SCHOOL_MESSAGE_DAYS=14
# SCHOOL_MARK_DAYS=14
# NASEMS_POLL_MINUTES=180
# SCHOOL_NOTICE_DAYS=14
# SCHOOL_TIMETABLE_DAYS=14
# SCHOOL_HOMEWORK_DAYS=14
# SCHOOL_DAY_GRACE_MINUTES=15
# SCHOOL_MAX_LESSONS=10
# SCHOOL_MAX_HOMEWORK=12
