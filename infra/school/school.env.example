# Zkopiruj do /opt/school/school.env, prava 600, vlastnik root. Cte ho jen
# systemd pro school-web.service.
#
# Prihlaseni do Skoly OnLine - to same, kterym se prihlasuje webova aplikace
# nebo mobilni aplikace. Rodicovsky ucet je lepsi nez zakovsky: dite si heslo
# muze zmenit a rozvrh by zhasl. Heslo se neposila nikam jinam nez na
# aplikace.skolaonline.cz.
SCHOOL_USERNAME=rodic.novak
SCHOOL_PASSWORD=heslo

# Ucet s vic detmi: ID nebo cast jmena. Prazdne = prvni dite. Seznam deti
# vypise --probe, viz infra/README.md, oddil Rozvrh a ukoly ze Skoly OnLine.
# SCHOOL_STUDENT=Adam

# Volitelne:
# SCHOOL_API=https://aplikace.skolaonline.cz/solapi/api
# SCHOOL_TZ=Europe/Prague
# SCHOOL_DAY_POLL_MINUTES=20
# SCHOOL_NIGHT_POLL_MINUTES=120
# SCHOOL_IDLE_POLL_MINUTES=120
# SCHOOL_HOLIDAY_POLL_MINUTES=360
# SCHOOL_AUTH_BACKOFF_HOURS=6
# Nahodna odchylka kazdeho odstupu v procentech (0 = presne).
# SCHOOL_POLL_JITTER_PERCENT=10
# SCHOOL_MAX_AGE_HOURS=14
# Noc bez dotazu do Skoly OnLine, od-do v hodinach; prazdne = bez ticha.
# SCHOOL_QUIET_HOURS=23-5
# Druha stranka obrazovky: neprectene zpravy a znamky. 0 = nestahovat.
# SCHOOL_MESSAGES=1
# SCHOOL_MARKS=1
# SCHOOL_MESSAGES_POLL_MINUTES=60
# SCHOOL_MARKS_POLL_MINUTES=180
# SCHOOL_MESSAGE_DAYS=14
# SCHOOL_MARK_DAYS=14
# SCHOOL_TIMETABLE_DAYS=14
# SCHOOL_HOMEWORK_DAYS=14
# SCHOOL_DAY_GRACE_MINUTES=15
# SCHOOL_MAX_LESSONS=10
# SCHOOL_MAX_HOMEWORK=12
