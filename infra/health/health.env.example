# /opt/health/health.env, prava 600, vlastnik root.
# Vlastni tema, ne to od upozorneni na dest a letadla ani od hlidani obchodu:
# poruchy serveru se tak daji v aplikaci ntfy ztlumit zvlast. Tema je heslo:
#   python3 -c "import secrets; print('hodiny-server-' + secrets.token_hex(16))"
NTFY_URL=https://ntfy.sh
NTFY_TOPIC=
NTFY_TOKEN=
# Jmeno serveru kvuli kontrole certifikatu (stejne jako CLOCK_HOST v .env).
HEALTH_HOST=
