[Unit]
Description=Prevypravec letadel z adsb.fi pro hodiny
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=opc
Environment=PLANES_PORT=8090
# Jen pro Caddy na stejnem stroji. Sluzba chodi ven na adsb.fi, takze na
# verejne IP by z ni byl otevreny prevypravec pro kohokoli.
Environment=PLANES_BIND=127.0.0.1
# Zadny venv: sluzba si vystaci se standardni knihovnou, na rozdil od
# generatoru zprav a agendy, ktere maji zavislosti.
#
# Interpret je vyslovne 3.11. Na Oracle Linuxu 8 je /usr/bin/python3 porad
# jeste 3.6, ktera neumi ani "from __future__ import annotations"; sluzba by
# se rozbila az za behu, ne pri nasazeni.
ExecStart=/usr/bin/python3.11 /opt/planes/serve.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
