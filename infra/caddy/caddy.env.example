# Vzor /etc/caddy/caddy.env. Skutecny soubor ma prava 600 a v repozitari
# nema co delat, stejne jako news.env nebo agenda.env.
#
# AGENDA_HASH je bcrypt hash hesla k /agenda.json. Vyrobi ho
#   caddy hash-password --plaintext 'tve-heslo'
# a Caddyfile ho cte jako {env.AGENDA_HASH}. Hodnota se necituje: systemd
# obsah EnvironmentFile nerozexpanduje, takze dolary v hashi prezijou.
AGENDA_HASH=$2a$14$vlozsemvystupzcaddyhashpassword
#
# SETTINGS_HASH je bcrypt hash hesla k /settings/, kde lezi zalohy nastaveni
# hodin. Heslo je jine nez u agendy: zaloha nese token Home Assistantu.
SETTINGS_HASH=$2a$14$vlozsemvystupzcaddyhashpassword
#
# PLANES_HASH je bcrypt hash hesla k /planes.json. Data jsou verejna, heslo
# brani tomu, aby si cizi pres server cerpal limit adsb.fi.
PLANES_HASH=$2a$14$vlozsemvystupzcaddyhashpassword
# LIGHTNING_HASH je bcrypt hash hesla k /lightning.json. Chrani data site
# Blitzortung, ktera se nesmi dal zverejnovat.
LIGHTNING_HASH=$2a$14$vlozsemvystupzcaddyhashpassword
# SCHOOL_HASH je bcrypt hash hesla k /school.json. Odpoved nese jmeno ditete
# a jeho ukoly ze Skoly OnLine.
SCHOOL_HASH=$2a$14$vlozsemvystupzcaddyhashpassword
