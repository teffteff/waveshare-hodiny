{{DOMAIN}} {
	# Vsechno na tomhle jmene jde jen pres HTTPS (port 80 jen presmerovava),
	# takze prohlizec, ktery tu jednou byl, uz se na http:// nezepta a heslo
	# od Home Assistanta nepujde otevrene ani omylem. Hodiny hlavicku ignoruji.
	# Bez includeSubDomains: nadrazena domena patri poskytovateli dynamicke DNS,
	# jeji dalsi poddomeny nejsou nase.
	header Strict-Transport-Security "max-age=31536000"
	handle /top.xml {
		reverse_proxy 127.0.0.1:8088
	}
	# Agenda nese titulky udalosti z rodinneho kalendare, takze na rozdil od
	# zprav nepatri komukoli. Jmeno serveru se da vycist z Certificate
	# Transparency, kam Let's Encrypt kazdy vydany certifikat zapisuje, takze
	# "adresu nikdo nezna" ochrana neni.
	#
	# Heslo posilaji hodiny samy a firmware kvuli tomu menit netreba:
	# HTTPClient si uzivatele a heslo vytahne z adresy tvaru
	# https://uzivatel:heslo@host/agenda.json a prilozi je hned k prvnimu
	# pozadavku jako hlavicku Authorization. Adresa proto musi byt https://,
	# na http:// by heslo slo po drate otevrene.
	#
	# Hash hesla je v /etc/caddy/caddy.env (prava 600), ne tady: tenhle soubor
	# lezi ve verejnem repozitari a bcrypt hash by z nej sel lamat offline.
	handle /agenda.json {
		basic_auth {
			hodiny {env.AGENDA_HASH}
		}
		reverse_proxy 127.0.0.1:8089
	}
	# Zalohy nastaveni hodin (infra/settings). Nesou token Home Assistantu
	# a heslo webu, takze patri za heslo stejne jako agenda - ale za vlastni:
	# heslo k agende zna kazde hodiny v adrese a nemelo by stacit na cteni
	# tokenu. Hash je v /etc/caddy/caddy.env jako SETTINGS_HASH.
	#
	# Strop tela je pojistka navic; server sam prijme nejvys 64 kB.
	handle /settings/* {
		basic_auth {
			hodiny {env.SETTINGS_HASH}
		}
		request_body {
			max_size 64KB
		}
		reverse_proxy 127.0.0.1:8092
	}
	# Letadla jsou verejna data z adsb.fi, takze heslo tu nechrani obsah, ale
	# stroj: server stahuje z adsb.fi a api.adsb.lol pro libovolnou polohu
	# a volaci znacku, pod nasi IP a User-Agentem s odkazem na repozitar.
	# Kdo by se ho ptal na ruzne polohy, mine cache a vycerpa limit
	# adsb.fi na IP - a radar na hodinach zustane prazdny.
	#
	# Heslo je vlastni (PLANES_HASH), ne to od agendy: adresa letadel se opisuje
	# do vic hodin a nemela by stacit na cteni kalendare. Firmware ho posila
	# stejne jako u agendy, z adresy https://hodiny:heslo@host/planes.json.
	handle /planes.json {
		basic_auth {
			hodiny {env.PLANES_HASH}
		}
		reverse_proxy 127.0.0.1:8090
	}
	# Blesky jsou data prispevatelu Blitzortung.org, ktera se nesmi dal
	# zverejnovat. Heslo tu proto chrani obsah: je to soukromy zdroj pro vlastni
	# hodiny, ne verejne API. Vlastni hash (LIGHTNING_HASH), aby adresa blesku
	# opsana do hodin nestacila na nic jineho.
	handle /lightning.json {
		basic_auth {
			hodiny {env.LIGHTNING_HASH}
		}
		reverse_proxy 127.0.0.1:8093
	}
	# Rozvrh a domaci ukoly ze Skoly OnLine (infra/school). Nese jmeno ditete,
	# tridu a ukoly, takze patri za heslo. Vlastni hash (SCHOOL_HASH), aby adresa
	# agendy nebo blesku opsana do hodin nestacila na cteni skolnich dat.
	handle /school.json {
		basic_auth {
			hodiny {env.SCHOOL_HASH}
		}
		reverse_proxy 127.0.0.1:8094
	}
	# Druzice nad hodinami (infra/satellites). Drahy jsou verejna data
	# CelesTraku, heslo chrani stroj: vypocet pro deset tisic druzic stoji
	# procesor a cizi dotazy na mnoho poloh by ho vytizily. Dotaz navic nese
	# polohu hodin. Vlastni hash (SATELLITES_HASH), aby adresa druzic opsana do
	# hodin nestacila na nic jineho. /satellites/status ven nevede.
	handle /satellites.json {
		basic_auth {
			hodiny {env.SATELLITES_HASH}
		}
		reverse_proxy 127.0.0.1:8095
	}
	# Srazkova predpoved z opendata.chmi.cz (infra/rain). Data jsou verejna,
	# takze heslo tu nechrani obsah, ale stroj: server stahuje pro libovolnou
	# polohu a kazda mina cache znamena dalsich 235 kB z CHMU pod nasi IP.
	# Dotaz navic nese polohu hodin. Vlastni hash (RAIN_HASH), aby adresa
	# srazek opsana do hodin nestacila na nic jineho. /rain/status ven nevede.
	handle /rain.json {
		basic_auth {
			hodiny {env.RAIN_HASH}
		}
		reverse_proxy 127.0.0.1:8096
	}
	# Prehled novinek z hlidanych obchodu (projekt scraping, /opt/watch).
	# Nese osobni sledovaci seznam a ceny, takze stejne jako agenda patri za
	# heslo; hash je v /etc/caddy/caddy.env, ne tady. Bez lomitka na konci by
	# se relativni odkazy na strance skladaly proti korenu domeny.
	redir /novinky /novinky/
	handle /novinky/* {
		basic_auth {
			hlidac {env.WATCHER_HASH}
		}
		uri strip_prefix /novinky
		reverse_proxy 127.0.0.1:8091
	}
	handle {
		reverse_proxy 127.0.0.1:8123
	}
}
