{
	# Jen HTTP/1.1 a HTTP/2. HTTP/3 (QUIC) potrebuje UDP 443, ktere firewall
	# serveru nepousti; Caddy ho presto nabizel v Alt-Svc a Chrome se k nemu
	# porad pokousel. Kdyby se UDP 443 nekdy otevrelo, staci radek smazat.
	servers {
		protocols h1 h2
	}
}

{{DOMAIN}} {
	# Vsechno na tomhle jmene jde jen pres HTTPS (port 80 jen presmerovava),
	# takze prohlizec, ktery tu jednou byl, uz se na http:// nezepta a heslo
	# od Home Assistanta nepujde otevrene ani omylem. Hodiny hlavicku ignoruji.
	# Bez includeSubDomains: nadrazena domena patri poskytovateli dynamicke DNS,
	# jeji dalsi poddomeny nejsou nase.
	header Strict-Transport-Security "max-age=31536000"
	# Prohlizece si HTTP/3 z drivejsiho Alt-Svc pamatuji az mesic (Chrome ho
	# mel ulozeny i s 155 neuspesnymi pokusy); "clear" je prinuti zapomenout.
	header Alt-Svc "clear"
	handle /top.xml {
		reverse_proxy 127.0.0.1:8088
	}
	# Agenda nese titulky udalosti z rodinneho kalendare, takze na rozdil od
	# zprav nepatri komukoli. Jmeno serveru se da vycist z Certificate
	# Transparency, kam Let's Encrypt kazdy vydany certifikat zapisuje, takze
	# "adresu nikdo nezna" ochrana neni.
	#
	# Heslo posilaji hodiny samy a firmware kvuli tomu menit netreba:
	# HTTPClient si uzivatele a heslo vytahne z adresy tvaru
	# https://uzivatel:heslo@host/agenda.json a prilozi je hned k prvnimu
	# pozadavku jako hlavicku Authorization. Adresa proto musi byt https://,
	# na http:// by heslo slo po drate otevrene.
	#
	# Hash hesla je v /etc/caddy/caddy.env (prava 600), ne tady: tenhle soubor
	# lezi ve verejnem repozitari a bcrypt hash by z nej sel lamat offline.
	handle /agenda.json {
		basic_auth {
			hodiny {env.AGENDA_HASH}
		}
		reverse_proxy 127.0.0.1:8089
	}
	# Zalohy nastaveni hodin (infra/settings). Nesou token Home Assistantu
	# a heslo webu, takze patri za heslo stejne jako agenda - ale za vlastni:
	# heslo k agende zna kazde hodiny v adrese a nemelo by stacit na cteni
	# tokenu. Hash je v /etc/caddy/caddy.env jako SETTINGS_HASH.
	#
	# Strop tela je pojistka navic; server sam prijme nejvys 64 kB.
	handle /settings/* {
		basic_auth {
			hodiny {env.SETTINGS_HASH}
		}
		request_body {
			max_size 64KB
		}
		reverse_proxy 127.0.0.1:8092
	}
	# Letadla jsou verejna data z adsb.fi, takze heslo tu nechrani obsah, ale
	# stroj: server stahuje z adsb.fi a api.adsb.lol pro libovolnou polohu
	# a volaci znacku, pod nasi IP a User-Agentem s odkazem na repozitar.
	# Kdo by se ho ptal na ruzne polohy, mine cache a vycerpa limit
	# adsb.fi na IP - a radar na hodinach zustane prazdny.
	#
	# Heslo je vlastni (PLANES_HASH), ne to od agendy: adresa letadel se opisuje
	# do vic hodin a nemela by stacit na cteni kalendare. Firmware ho posila
	# stejne jako u agendy, z adresy https://hodiny:heslo@host/planes.json.
	handle /planes.json {
		basic_auth {
			hodiny {env.PLANES_HASH}
		}
		reverse_proxy 127.0.0.1:8090
	}
	# Blesky jsou data prispevatelu Blitzortung.org, ktera se nesmi dal
	# zverejnovat. Heslo tu proto chrani obsah: je to soukromy zdroj pro vlastni
	# hodiny, ne verejne API. Vlastni hash (LIGHTNING_HASH), aby adresa blesku
	# opsana do hodin nestacila na nic jineho.
	handle /lightning.json {
		basic_auth {
			hodiny {env.LIGHTNING_HASH}
		}
		reverse_proxy 127.0.0.1:8093
	}
	# Rozvrh a domaci ukoly ze Skoly OnLine (infra/school). Nese jmeno ditete,
	# tridu a ukoly, takze patri za heslo. Vlastni hash (SCHOOL_HASH), aby adresa
	# agendy nebo blesku opsana do hodin nestacila na cteni skolnich dat.
	handle /school.json {
		basic_auth {
			hodiny {env.SCHOOL_HASH}
		}
		reverse_proxy 127.0.0.1:8094
	}
	# Druzice nad hodinami (infra/satellites). Drahy jsou verejna data
	# CelesTraku, heslo chrani stroj: vypocet pro deset tisic druzic stoji
	# procesor a cizi dotazy na mnoho poloh by ho vytizily. Dotaz navic nese
	# polohu hodin. Vlastni hash (SATELLITES_HASH), aby adresa druzic opsana do
	# hodin nestacila na nic jineho. /satellites/status ven nevede.
	handle /satellites.json {
		basic_auth {
			hodiny {env.SATELLITES_HASH}
		}
		reverse_proxy 127.0.0.1:8095
	}
	# Srazkova predpoved z opendata.chmi.cz (infra/rain). Data jsou verejna,
	# takze heslo tu nechrani obsah, ale stroj: server stahuje pro libovolnou
	# polohu a kazda mina cache znamena dalsich 235 kB z CHMU pod nasi IP.
	# Dotaz navic nese polohu hodin. Vlastni hash (RAIN_HASH), aby adresa
	# srazek opsana do hodin nestacila na nic jineho. /rain/status ven nevede.
	handle /rain.json {
		basic_auth {
			hodiny {env.RAIN_HASH}
		}
		reverse_proxy 127.0.0.1:8096
	}
	# Vystrahy CHMU pro polohu hodin (infra/warnings). Data jsou verejna a CAP se
	# stahuje nejvys jednou za pet minut pro vsechny, takze heslo nechrani obsah
	# ani CHMU, ale polohu hodin v dotazu a stroj pred cizim provozem. Vlastni
	# hash (WARNINGS_HASH), aby adresa vystrah opsana do hodin nestacila na nic
	# jineho. /warnings/status ven nevede.
	handle /warnings.json {
		basic_auth {
			hodiny {env.WARNINGS_HASH}
		}
		reverse_proxy 127.0.0.1:8097
	}
	# Nastaveni upozorneni na telefon (infra/alerts). Hodiny sem po ulozeni
	# posilaji polohu a co se ma hlidat; server pak posila push i bez nich.
	# Vlastni hash (ALERTS_HASH): kdo ho zna, muze prepsat polohu a zaplavit
	# telefon upozornenimi. /alerts/status ven nevede.
	handle /alerts/config/* {
		basic_auth {
			hodiny {env.ALERTS_HASH}
		}
		request_body {
			max_size 4KB
		}
		reverse_proxy 127.0.0.1:8098
	}
	# Stranky pro prohlizec (nastaveni hodin, novinky) bydli na vlastnim jmenu
	# {{FLEET_DOMAIN}}. Tady by je obsluhoval service worker Home Assistanta
	# (scope /): ukazoval by stranky z mezipameti o navsteva pozde (prihlaseni
	# bez zmeny, stary token proti CSRF) a sdilely by s HA uloziste prohlizece.
	# Stare adresy presmeruji i s cestou.
	redir /fleet https://{{FLEET_DOMAIN}}/ permanent
	handle_path /fleet/* {
		redir https://{{FLEET_DOMAIN}}{uri} permanent
	}
	redir /novinky https://{{FLEET_DOMAIN}}/novinky/ permanent
	handle_path /novinky/* {
		redir https://{{FLEET_DOMAIN}}/novinky{uri} permanent
	}
	handle {
		reverse_proxy 127.0.0.1:8123
	}
}

{{FLEET_DOMAIN}} {
	header Strict-Transport-Security "max-age=31536000"
	# Prehled novinek z hlidanych obchodu (projekt scraping, /opt/watch).
	# Nese osobni sledovaci seznam a ceny, takze stejne jako agenda patri za
	# heslo; hash je v /etc/caddy/caddy.env, ne tady. Bez lomitka na konci by
	# se relativni odkazy na strance skladaly proti korenu domeny.
	redir /novinky /novinky/
	handle /novinky/* {
		basic_auth {
			hlidac {env.WATCHER_HASH}
		}
		uri strip_prefix /novinky
		reverse_proxy 127.0.0.1:8091
	}
	# Statistiky letu kolem domu (repozitar radar, radar-web.service). Nese
	# polohu domu a kdy tu co letelo, takze patri za heslo. Zamerne stejne jako
	# novinky (uzivatel hlidac, WATCHER_HASH): prohlizec prihlaseny k novinkam
	# se na radar uz nepta. Bez lomitka na konci by se relativni adresy api/
	# a app.js skladaly proti korenu domeny.
	redir /radar /radar/
	handle /radar/* {
		basic_auth {
			hlidac {env.WATCHER_HASH}
		}
		uri strip_prefix /radar
		reverse_proxy 127.0.0.1:8100
	}
	# Statistiky funkci hodin (repozitar hodiny-stats, stats-web.service):
	# upozorneni na dest proti srazkomeru doma, pozdeji blesky, vystrahy a dalsi.
	# Nese polohu domu a data z Home Assistanta, takze za stejne heslo jako radar.
	redir /hodiny /hodiny/
	handle /hodiny/* {
		basic_auth {
			hlidac {env.WATCHER_HASH}
		}
		uri strip_prefix /hodiny
		reverse_proxy 127.0.0.1:8101
	}
	# Uceni pro deti (repozitar learning, learning-web.service): procvicovani na
	# /uceni/, statistiky /hodiny/uceni/. Heslo k /uceni/ resi sama sluzba (na
	# zarizeni se zada jednou, pak si ho pamatuje cookie a zarizeni jdou zrusit
	# na strance statistik), proto tu neni basic_auth. Statistiky jsou za
	# stejnym heslem jako /hodiny/ a maji vlastni port, aby se na ne pres
	# /uceni/ nedalo dostat. /hodiny/uceni/* je delsi cesta nez /hodiny/*, takze
	# ji Caddy vyhodnoti driv a do hodiny-stats nepropadne.
	redir /uceni /uceni/
	handle /uceni/* {
		uri strip_prefix /uceni
		reverse_proxy 127.0.0.1:8104
	}
	redir /hodiny/uceni /hodiny/uceni/
	handle /hodiny/uceni/* {
		basic_auth {
			hlidac {env.WATCHER_HASH}
		}
		uri strip_prefix /hodiny/uceni
		reverse_proxy 127.0.0.1:8105
	}
	# Mapa autobusu PID kolem Ondrejova (repozitar bus, bus-web.service).
	# Polohy jsou verejna data PID z Golemia a server je stahuje nejvys jednou
	# za 15 s pro vsechny, at se diva kdokoli, takze heslo nechrani obsah ani
	# stroj a stranka je bez nej (i pro telefon, ktery se k novinkam
	# neprihlasuje). Bez lomitka na konci by se relativni adresy api/ a app.js
	# skladaly proti korenu domeny.
	redir /bus /bus/
	handle /bus/* {
		uri strip_prefix /bus
		reverse_proxy 127.0.0.1:8103
	}
	# Nastaveni vsech hodin pres server (infra/fleet, FLEET_PREFIX prazdny).
	# Hodiny se sem pripojuji samy a server jim predava pozadavky z prohlizece,
	# takze kdo je tu prihlaseny, nastavuje hodiny doma. Heslo a kod TOTP resi
	# sama sluzba (basic_auth by kolidoval s tokenem hodin v Authorization).
	# Odpoved hodin nese stranku nastaveni (kolem 80 kB gzipem).
	respond /fleet-status 404
	handle {
		request_body {
			max_size 1MB
		}
		reverse_proxy 127.0.0.1:8099
	}
}
