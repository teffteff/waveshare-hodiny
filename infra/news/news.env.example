# Zkopiruj do /opt/news/news.env, dopln token, prava 600, vlastnik root;
# systemd ho nacte pred prepnutim na uzivatele news.
# Model se voli pres branu infra/llm (Gemini, zaloha OpenRouter). Klice ma
# brana; sem patri jen token sluzby "news" z LLM_TOKENS v /opt/llm/llm.env.
LLM_TOKEN=...

# Volitelne:
# NEWS_LLM_TIER=smart
# LLM_URL=http://127.0.0.1:8102/v1/chat/completions
# NEWS_OUTPUT=/opt/news/www/top.xml
# Výběr podle polohy hodin (adresa kanálu s ?city={city}&lat={lat}&lon={lon}).
# Strop poloh musí sedět s news-web.service.
# NEWS_STATE=/opt/news/state/locations
# NEWS_MAX_LOCATIONS=4
# NEWS_LOCATION_TTL_DAYS=7
# NEWS_REGIONAL_FEEDS=https://ct24.ceskatelevize.cz/rss/rubrika/regiony-12,https://brnensky.denik.cz/rss/vse.xml
# NEWS_REGIONAL_MAX_AGE_HOURS=48
# Adresa kanálu do <link>; hodiny ji nečtou, čtečky ano.
# NEWS_LINK=https://tvuj-stroj.example.net/top.xml
