# Zkopiruj do /opt/news/news.env, dopln klic, prava 600, vlastnik toho uctu,
# pod kterym bezi news.service.
# Generator jede na Google Gemini (google-genai), ne na Claude.
GEMINI_API_KEY=AQ....

# Volitelne:
# NEWS_MODEL=gemini-flash-latest
# NEWS_FALLBACK_MODELS=gemini-flash-lite-latest,gemini-3.6-flash
# NEWS_OUTPUT=/opt/news/www/top.xml
# Adresa kanálu do <link>; hodiny ji nečtou, čtečky ano.
# NEWS_LINK=https://tvuj-stroj.example.net/top.xml
